{
  "description": "Run Workshop Booking verification before Codex finishes a turn.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$(git rev-parse --show-toplevel)/.codex/hooks/verify.ps1\"",
            "timeout": 1800,
            "statusMessage": "Running project verification"
          }
        ]
      }
    ]
  }
}
