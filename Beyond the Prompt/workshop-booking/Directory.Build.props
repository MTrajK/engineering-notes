<Project>
  <!-- Place at the repository root; applies to application and test projects. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Analyzer baseline matches the .NET 10 SDK pinned in global.json. -->
    <AnalysisLevel>10-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Coverage is enforced separately by scripts/Test-UnitCoverage.ps1. -->
</Project>
