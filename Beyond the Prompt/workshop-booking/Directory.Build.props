<Project>
  <!-- Place at the repository root; applies to application and test projects. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Stable rule baseline for the planned .NET 10 SDK; pin the SDK in global.json. -->
    <AnalysisLevel>10-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- TargetFramework and package versions belong in scaffolding configuration.
       Do not set preview LangVersion, disable rules for tests globally, or claim
       that this file enforces coverage. Verify build and format after scaffolding. -->
</Project>
